<aside class="filterBarContainer">
    <form action="GET">
        <h2>Type</h2>
        <label for="phones">
            <input type="checkbox" name="phones"/>
            Phones
        </label>
        <label for="devices">
            <input type="checkbox" name="devices"/>
            Laptops
        </label>

        <h2>Brand</h2>
        <label for="apple">
            <input type="checkbox" name="apple"/>
            Apple
        </label>
        <label for="dell">
            <input type="checkbox" name="dell"/>
            Dell
        </label>
        <label for="samsung">
            <input type="checkbox" name="samsung"/>
            Samsung
        </label>
        
        <label for="microsoft">
            <input type="checkbox" name="microsoft"/>
            Microsoft
        </label>

        <h2>Price</h2>
        <label for="priceFrom">From</label>
        <input type="number" name="priceFrom"/>
        <label for="priceTo">To</label>
        <input type="number" name="priceTo"/>

        <button>Filter</button>
    </form>
</aside>