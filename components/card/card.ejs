<a href="/item?name=<%=locals.product.name%>" class="productCard">
    <main class="productCardName">
        <img class="productCardImage" src="/img/<%= locals.product.id %>.png" alt="<%= locals.product.category %>">
        <p><%= locals.product.name %></p>
    </main>
    <footer class="productCardPrice">
        <h3>$ <%= locals.product.price %></h3>
    </footer>
    
</a>
