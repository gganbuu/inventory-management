<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preload" href="/fonts/OpenSans.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/styles.css">
    <title>Document</title>
</head>
<body class="noScrollBody">
    <%- include('../components/navbar/navbar') %>
    <main class="itemMain">
        <article class="itemImage">
            <a href="/products">back to products</a>
            <img src="/img/<%= locals.item.id %>.png" alt="<%= locals.item.category %>">
        </article>
        <article class="itemDetails">
            <main class="itemDetailsMain">
                <div class="itemDetailsHeader">
                    <%- include('../components/infobubble/infobubble', { input: locals.item.devices, category: 'devices'}) %>
                    <%- include('../components/infobubble/infobubble', { input: locals.item.brand, category: 'brand'}) %>
                </div>
                <h1><%= locals.item.name %></h1>
                <p> <%= locals.item.description %></p>
            </main>
            <footer class="itemDetailsFooter"> 
                <p>id: <%= locals.item.id %></p>
                <p><%= locals.item.stock %> in stock</p>
            </footer>
        </article>
    </main>
    <%- include('../components/footer/footer') %>
</body>
</html>