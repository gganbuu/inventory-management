<% const products = locals.products%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preload" href="/fonts/OpenSans.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/styles.css">
    <title>Edit delete</title>
</head>
<body class="noScrollBody">
    <%- include('../components/adminnavbar/adminnavbar') %>
    <main class="editDeleteMain">
        <header class="editDeleteHeading">
            <h2>Edit/Delete</h2>    
        </header>
        <main class="editDeleteTable">
            <h3>id</h3>
            <h3>name</h3>
            <h3>devices</h3>
            <h3>stock</h3>
            <h3>colour</h3>
            <h3>price</h3>
            <h3>brand</h3>
            <h3></h3>

            <% products.forEach(product => { %>
               <p><%- product.id %></p>
               <p><%- product.name %></p>
               <p><%- product.devices %></p>
               <p><%- product.stock %></p>
               <p><%- product.colour %></p>
               <p>$ <%- product.price %></p>
               <p><%- product.brand %></p>
               <div>
                   <a class="editButton" href="/edit/<%= product.id%>">edit</a>
                   <button>delete</button>
               </div>
            <% }) %>
 
            
        </main>
        <footer>
        </footer>
    </main>
    <%- include('../components/footer/footer') %>
</body>
</html>

<script>

</script>